# Runtime configuration of the detector service (names only, no secrets here).
# See docs/interface-contract.md §7 for the full reference.

SOURCE=file                       # file | postgres
SOURCE_FILES=data/raw/synth_bf_v1/auth.jsonl

# Live Postgres source (SOURCE=postgres)
PG_DSN=                           # e.g. postgresql://detector_ro:***@postgres-authentication.applications:5432/authentication
PG_POLL_OVERLAP_S=10

SINK=stdout                       # stdout | http | remediate (IA executes)                       # stdout | http
REMEDIATION_URL=                  # e.g. http://remediation.cyber.svc.cluster.local:8080
REMEDIATION_TOKEN=

ENABLED_DETECTORS=auth_bruteforce
MODELS_DIR=models
COOLDOWN_S=300
SCORE_THRESHOLD=0                 # 0 = model threshold (0.9); raise it to cut false positives
EVENT_RATE_CAP_PER_MIN=10
PROTECTED_IPS=                    # comma list of IPs or CIDRs
METRICS_PORT=9108
LOG_LEVEL=info

# RAG (optional, in the loop with a timeout and ML fallback)
RAG_ENABLED=false
OLLAMA_URL=http://ollama.ia.svc.cluster.local:11434
RAG_MODEL=mistral:7b              # Mistral 7B (7.3B parameters, under the 8B limit)
RAG_EMBED_MODEL=nomic-embed-text  # embeddings for runbook retrieval
RAG_DOCS_DIR=runbooks
RAG_TIMEOUT_S=9

# MLflow (training only): local by default
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Remediation executor (SINK=remediate): IA blocks the attacker IP in APISIX.
REMEDIATION_MODE=dry_run          # dry_run (no cluster change) | apisix
APISIX_ADMIN_URL=http://apisix-admin.apisix.svc.cluster.local:9180/apisix/admin
APISIX_ADMIN_KEY=                 # from Vault apps/apisix-admin (ask Karim)
APISIX_GLOBAL_RULE_ID=ia-ipblock
BLOCK_TTL_S=900                   # auto-unblock after 15 min, no human action
RESTART_ENABLED=false            # restart_service via kubectl (bonus)
KUBECTL_BIN=kubectl

# Falco receiver (CYBER's Falcosidekick POSTs here)
RECEIVER_ENABLED=false
RECEIVER_PORT=5000
